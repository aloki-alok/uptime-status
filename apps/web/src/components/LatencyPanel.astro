---
import type { StatusSnapshot, SiteConfig } from "@uptime-status/domain";

type Props = {
  components: StatusSnapshot["components"];
  site: SiteConfig;
};

const { components, site } = Astro.props;
const measured = components.filter((component) => component.latency !== null);

function chartData(latency: NonNullable<(typeof measured)[number]["latency"]>) {
  const values = latency.map((point) => point.avgMs);
  const min = Math.floor(Math.min(...values) / 25) * 25;
  const roundedMax = Math.ceil(Math.max(...values) / 25) * 25;
  const max = Math.max(roundedMax, min + 25);
  const span = max - min;
  const latestAt = Date.parse(latency.at(-1)?.observedAt ?? "");
  const windowStart = latestAt - 59 * 60_000;
  const point = (value: number, observedAt: string) => {
    const elapsed = Math.max(0, Math.min(59 * 60_000, Date.parse(observedAt) - windowStart));
    const x = 18 + (elapsed / (59 * 60_000)) * 564;
    const y = 142 - ((value - min) / span) * 118;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  };
  const samples = latency.map((item) => point(item.avgMs, item.observedAt)).join(" ");
  const average = Math.round(
    latency.reduce((sum, item) => sum + item.avgMs, 0) / latency.length,
  );

  return { average, max, min, samples, windowStart };
}

const time = new Intl.DateTimeFormat(site.locale, {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: site.timeZone,
  timeZoneName: "short",
});
---

{measured.length > 0 && (
  <section class="latency-section" aria-labelledby="latency-title">
    <div class="section-heading latency-heading">
      <div>
        <p class="eyebrow">Recent checks</p>
        <h2 id="latency-title">Response time</h2>
      </div>
      <p>Recent published response times. Lower is faster.</p>
    </div>
    <div class="latency-grid">
      {measured.map((component) => {
        const latency = component.latency;
        if (!latency) return null;
        const data = chartData(latency);
        const current = Math.round(latency.at(-1)?.avgMs ?? 0);
        const lastObservedAt = latency.at(-1)?.observedAt;
        return (
          <figure class="latency-card" data-latency-slug={component.slug}>
            <figcaption>
              <div>
                <h3>{component.name}</h3>
                <span class="state-label" data-latency-checked>Checked {lastObservedAt ? time.format(new Date(lastObservedAt)) : "unknown"}</span>
              </div>
              <dl>
                <div><dt>Latest</dt><dd data-latency-now>{current} ms</dd></div>
                <div><dt>Average</dt><dd data-latency-average>{data.average} ms</dd></div>
                <div><dt>Checks</dt><dd data-latency-count>{latency.length}</dd></div>
              </dl>
            </figcaption>
            <div class="chart-wrap">
              <svg
                viewBox="0 0 600 160"
                role="img"
                aria-label={`${component.name} response time across ${latency.length} published checks in the latest 60-minute window. Latest ${current} milliseconds and average ${data.average} milliseconds. Missing minutes remain gaps. Scale ${data.min} to ${data.max} milliseconds.`}
              >
                <line x1="18" y1="24" x2="582" y2="24" class="chart-grid" />
                <line x1="18" y1="83" x2="582" y2="83" class="chart-grid" />
                <line x1="18" y1="142" x2="582" y2="142" class="chart-grid" />
                <polyline points={data.samples} class="chart-average" data-chart-average />
              </svg>
              <div class="chart-scale" aria-hidden="true">
                <span data-chart-max>{data.max} ms</span>
                <span data-chart-min>{data.min} ms</span>
              </div>
            </div>
            <div class="chart-axis" aria-hidden="true">
              <span data-chart-start>{time.format(new Date(data.windowStart))}</span>
              <span>Latest</span>
            </div>
            <div class="chart-legend" aria-hidden="true">
              <span><i class="legend-average"></i>Observed response time</span>
            </div>
          </figure>
        );
      })}
    </div>
  </section>
)}
