---
import type { StatusSnapshot, SiteConfig } from "@uptime-status/domain";

type Props = {
  components: StatusSnapshot["components"];
  site: SiteConfig;
};

const { components, site } = Astro.props;
const MINUTE_MS = 60_000;
const GAP_THRESHOLD_MS = MINUTE_MS * 1.5;

function windowLatency(
  latency: NonNullable<StatusSnapshot["components"][number]["latency"]>,
  latestObservedAt: string,
) {
  const end = Date.parse(latestObservedAt);
  const windowStart = Math.floor(end / MINUTE_MS) * MINUTE_MS - 59 * MINUTE_MS;
  return latency.filter((item) => {
    const observedAt = Date.parse(item.observedAt);
    return observedAt >= windowStart && observedAt <= end;
  });
}

const measured = components.filter((component) => component.latency !== null);

function chartData(
  latency: NonNullable<(typeof measured)[number]["latency"]>,
  latestObservedAt: string,
) {
  const recent = windowLatency(latency, latestObservedAt);
  if (recent.length === 0) return null;
  const values = recent.map((point) => point.avgMs);
  const min = Math.floor(Math.min(...values) / 25) * 25;
  const roundedMax = Math.ceil(Math.max(...values) / 25) * 25;
  const max = Math.max(roundedMax, min + 25);
  const span = max - min;
  const endBucket = Math.floor(Date.parse(latestObservedAt) / MINUTE_MS) * MINUTE_MS;
  const windowStart = endBucket - 59 * MINUTE_MS;
  const point = (value: number, observedAt: string) => {
    const elapsed = Math.max(0, Math.min(59 * 60_000, Date.parse(observedAt) - windowStart));
    const x = 18 + (elapsed / (59 * 60_000)) * 564;
    const y = 142 - ((value - min) / span) * 118;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  };
  const points = recent.map((item) => {
    const [x, y] = point(item.avgMs, item.observedAt).split(",").map(Number);
    return { ...item, x, y };
  });
  const segments = points.reduce<(typeof points)[]>((result, item, index) => {
    const previous = points[index - 1];
    if (!previous || Date.parse(item.observedAt) - Date.parse(previous.observedAt) > GAP_THRESHOLD_MS) {
      result.push([item]);
    } else {
      result.at(-1)?.push(item);
    }
    return result;
  }, []);
  const checks = recent.reduce((sum, item) => sum + item.sampleCount, 0);
  const average = Math.round(
    recent.reduce((sum, item) => sum + item.avgMs * item.sampleCount, 0) / checks,
  );

  return { average, checks, max, min, points, segments, windowStart };
}

const time = new Intl.DateTimeFormat(site.locale, {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: site.timeZone,
  timeZoneName: "short",
});
const number = new Intl.NumberFormat(site.locale, { maximumFractionDigits: 0 });
---

{measured.length > 0 && (
  <section class="latency-section" aria-labelledby="latency-title">
    <div class="section-heading latency-heading">
      <div>
        <p class="eyebrow">Recent checks</p>
        <h2 id="latency-title">Response time</h2>
      </div>
      <p>Recent published response times. Lower is faster.</p>
    </div>
    <div class="latency-grid">
      {measured.map((component) => {
        const latency = component.latency;
        if (!latency) return null;
        const chart = chartData(latency, component.latestObservedAt);
        const data = chart ?? {
          average: 0,
          checks: 0,
          max: 25,
          min: 0,
          points: [],
          segments: [],
          windowStart:
            Math.floor(Date.parse(component.latestObservedAt) / MINUTE_MS) * MINUTE_MS -
            59 * MINUTE_MS,
        };
        const current = Math.round(data.points.at(-1)?.avgMs ?? 0);
        const lastObservedAt = data.points.at(-1)?.observedAt;
        const tooltipId = `latency-tooltip-${component.slug}`;
        return (
          <figure class="latency-card" data-latency-slug={component.slug} hidden={chart === null}>
            <figcaption>
              <div>
                <h3>{component.name}</h3>
                <span class="state-label" data-latency-checked>Checked {time.format(new Date(component.latestObservedAt))}</span>
              </div>
              <dl>
                <div><dt>Latest sample</dt><dd data-latency-now>{number.format(current)} ms</dd></div>
                <div><dt>Average</dt><dd data-latency-average>{number.format(data.average)} ms</dd></div>
                <div><dt>Checks</dt><dd data-latency-count>{number.format(data.checks)}</dd></div>
              </dl>
            </figcaption>
            <div class="chart-wrap">
              <svg
                viewBox="0 0 600 160"
                role="img"
                aria-label={`${component.name} response time across ${data.checks} published checks in the latest 60-minute window. Latest sample ${current} milliseconds and weighted average ${data.average} milliseconds. Missing minutes remain gaps. Scale ${data.min} to ${data.max} milliseconds.`}
              >
                <line x1="18" y1="24" x2="582" y2="24" class="chart-grid" />
                <line x1="18" y1="83" x2="582" y2="83" class="chart-grid" />
                <line x1="18" y1="142" x2="582" y2="142" class="chart-grid" />
                <g data-chart-segments>
                  {data.segments.map((segment) => (
                    <polyline points={segment.map((item) => `${item.x},${item.y}`).join(" ")} class="chart-average" data-chart-segment />
                  ))}
                </g>
                <g data-chart-samples>
                  {data.points.map((item) => <circle cx={item.x} cy={item.y} r="1.7" class="chart-sample" />)}
                </g>
                <line x1="0" y1="24" x2="0" y2="142" class="chart-cursor" data-chart-cursor visibility="hidden" />
                <circle cx="0" cy="0" r="4" class="chart-cursor-point" data-chart-cursor-point visibility="hidden" />
              </svg>
              <div class="chart-scale" aria-hidden="true">
                <span data-chart-max>{data.max} ms</span>
                <span data-chart-min>{data.min} ms</span>
              </div>
              <button
                type="button"
                class="chart-interaction"
                aria-label={`Inspect ${component.name} response-time observations. Use left and right arrow keys to move between checks.`}
                aria-describedby={tooltipId}
                data-latency-interaction
                data-chart-points={JSON.stringify(data.points)}
              ></button>
              <div class="latency-tooltip" id={tooltipId} role="tooltip" data-latency-tooltip hidden>
                <time data-latency-tooltip-time datetime={lastObservedAt}></time>
                <strong data-latency-tooltip-value></strong>
                <span data-latency-tooltip-samples></span>
              </div>
              <span class="visually-hidden" aria-live="polite" data-latency-announcement></span>
            </div>
            <div class="chart-axis" aria-hidden="true">
              <span data-chart-start>{time.format(new Date(data.windowStart))}</span>
              <span>Latest</span>
            </div>
            <div class="chart-legend" aria-hidden="true">
              <span><i class="legend-average"></i>Observed response time</span>
            </div>
          </figure>
        );
      })}
    </div>
  </section>
)}
