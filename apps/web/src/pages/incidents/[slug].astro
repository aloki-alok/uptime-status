---
import {
  type Incident,
} from "@uptime-status/domain";
import SiteHeader from "../../components/SiteHeader.astro";
import SubscribeDialog from "../../components/SubscribeDialog.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { snapshot, site } from "../../lib/build-data";

export function getStaticPaths() {
  const incidents = [
    ...snapshot.activeIncidents,
    ...snapshot.recentEvents.filter((event): event is Incident => "startedAt" in event),
  ];

  return incidents.map((incident) => ({ params: { slug: incident.slug }, props: { incident } }));
}

const { incident } = Astro.props as { incident: Incident };
const componentNames = new Map(
  snapshot.components.map((component) => [component.slug, component.name]),
);
const dateTime = new Intl.DateTimeFormat(site.locale, {
  day: "numeric",
  month: "short",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
  timeZone: site.timeZone,
  timeZoneName: "short",
});
const latestUpdate = incident.updates.at(-1);
const updatesNewestFirst = incident.updates.toReversed();
const stateLabel = incident.state.replaceAll("_", " ");
---

<BaseLayout
  title={`${incident.title} | ${site.displayName} status`}
  description={`Current details and updates for ${incident.title}.`}
  locale={site.locale}
>
  <div class="page-shell">
    <SiteHeader active="history" {site} />
    <main id="main-content" class="incident-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/history/">Past incidents</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Incident</span>
      </nav>

      <header class="incident-heading">
        <div>
          <p class="eyebrow">Active incident</p>
          <h1>{incident.title}</h1>
        </div>
        <span class:list={["incident-state", `text-${incident.impact}`]}>{stateLabel}</span>
      </header>

      <section class="incident-summary" aria-label="Incident summary">
        <dl>
          <div>
            <dt>Started</dt>
            <dd><time datetime={incident.startedAt}>{dateTime.format(new Date(incident.startedAt))}</time></dd>
          </div>
          <div>
            <dt>Impact</dt>
            <dd>{incident.impact === "major_outage" ? "Major outage" : "Degraded performance"}</dd>
          </div>
          <div>
            <dt>Affected</dt>
            <dd>
              {incident.affectedComponents
                .map((slug: string) => componentNames.get(slug) ?? slug)
                .join(", ")}
            </dd>
          </div>
          {latestUpdate?.nextUpdateBy && (
            <div>
              <dt>Next update by</dt>
              <dd>
                <time datetime={latestUpdate.nextUpdateBy}>
                  {dateTime.format(new Date(latestUpdate.nextUpdateBy))}
                </time>
              </dd>
            </div>
          )}
        </dl>
      </section>

      <section class="incident-timeline" aria-labelledby="updates-title">
        <header>
          <p class="eyebrow">Response log</p>
          <h2 id="updates-title">Incident updates</h2>
        </header>
        <ol>
          {updatesNewestFirst.map((update) => (
            <li>
              <div class="timeline-marker" aria-hidden="true"></div>
              <article aria-labelledby={`incident-${update.id}`}>
                <div class="timeline-meta">
                  <h3 id={`incident-${update.id}`}>{update.state.replaceAll("_", " ")}</h3>
                  <time datetime={update.publishedAt}>
                    {dateTime.format(new Date(update.publishedAt))}
                  </time>
                </div>
                <p>{update.message}</p>
              </article>
            </li>
          ))}
        </ol>
      </section>
    </main>
  </div>
  <SubscribeDialog {site} />
</BaseLayout>
