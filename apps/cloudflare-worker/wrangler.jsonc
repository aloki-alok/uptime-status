{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uptime-status-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "STATUS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      "binding": "SUBSCRIPTIONS_DATABASE",
      "database_name": "uptime-status-example-subscriptions",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SUBSCRIPTION_CONFIRMATIONS",
        "queue": "uptime-status-example-confirmations"
      }
    ],
    "consumers": [
      {
        "queue": "uptime-status-example-confirmations",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "uptime-status-example-confirmations-dlq"
      }
    ]
  },
  "vars": {
    "SITE_ID": "example-site",
    "TARGET_URL": "https://example.com/",
    "COMPONENT_SLUG": "website",
    "COMPONENT_NAME": "Website",
    "COMPONENT_GROUP": "Website",
    "SHOW_LATENCY": "true",
    "POLL_INTERVAL_SECONDS": "60",
    "SUBSCRIPTION_ACCEPTANCE_ENABLED": "false"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
