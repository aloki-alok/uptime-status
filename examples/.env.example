# Available build inputs. This file is a reference and is not a generated deployment profile.

# Optional for the bundled example. Relative paths are resolved from apps/web.
STATUS_SITE_CONFIG=../../examples/status.config.json

# Required when the selected site uses deploymentMode "production".
# The file must contain a validated normalized status snapshot.
# STATUS_SNAPSHOT_PATH=/absolute/path/current.json

# Optional for `bun run dev:api`. Defaults to 3000.
PORT=3000

# The generated site template references this variable. Doctor checks presence
# only; the Kuma adapter is not implemented.
# UPTIME_KUMA_CONNECTION=local-check-only

# An SMTP site may reference an environment variable such as this one. Doctor
# checks presence only; no SMTP adapter parses or connects with it yet.
# SMTP_CONNECTION=local-check-only

# AWS profile, deployment environment, and SES resource inputs are intentionally
# absent. No current operator command consumes or deploys them.
